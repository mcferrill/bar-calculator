---
import "../styles/global.css";

interface Props {
	title?: string;
	active: "calculator" | "log";
}

const { title = "Bar Calculator", active } = Astro.props;

const linkBase = "px-4 py-2 rounded-sm text-sm font-medium";
const linkIdle = `${linkBase} text-gray-100 hover:bg-gray-700`;
const linkActive = `${linkBase} bg-gray-700 text-gray-100`;
---

<!doctype html>
<html class="bg-gray-900">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
	</head>
	<body class="min-h-screen bg-gray-900 text-gray-100">
		<nav class="flex gap-2 px-5 pt-4 pb-2 border-b border-gray-700">
			<a
				href="/"
				class={active === "calculator" ? linkActive : linkIdle}
				aria-current={active === "calculator" ? "page" : undefined}
			>
				Calculator
			</a>
			<a
				href="/log"
				class={active === "log" ? linkActive : linkIdle}
				aria-current={active === "log" ? "page" : undefined}
			>
				Exercise Log
			</a>
		</nav>
		<main>
			<slot />
		</main>
	</body>
</html>
