---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import ExerciseLog from "../components/ExerciseLog";
import { getLiveCollection } from "astro:content";
import { env } from "cloudflare:workers";
import {
	deleteSession,
	formValuesFromFormData,
	insertSession,
	sessionFromFormValues,
	sessionToFormValues,
	updateSession,
	type SessionFormValues,
} from "../lib/session";

let formError: string | undefined;
let editId = Astro.url.searchParams.get("edit") ?? undefined;
let submitted: SessionFormValues | undefined;

if (Astro.request.method === "POST") {
	try {
		const form = await Astro.request.formData();
		const intent = String(form.get("intent") ?? "create");
		if (intent === "delete") {
			const id = String(form.get("id") ?? "");
			if (!id) throw new Error("Missing session.");
			if (!(await deleteSession(env.DB, id))) throw new Error("Session not found.");
			return Astro.redirect("/log");
		}
		if (intent !== "create" && intent !== "update") throw new Error("Unknown action.");
		submitted = formValuesFromFormData(form);
		const session = sessionFromFormValues(submitted);
		let savedId: string;
		if (intent === "update") {
			savedId = String(form.get("id") ?? "");
			editId = savedId || editId;
			if (!savedId) throw new Error("Missing session.");
			if (!(await updateSession(env.DB, savedId, session))) {
				throw new Error("Session not found.");
			}
		} else {
			savedId = await insertSession(env.DB, session);
		}
		return Astro.redirect(`/log?saved=${savedId}`);
	} catch (err) {
		formError = err instanceof Error ? err.message : "Could not save session.";
	}
}

const result = await getLiveCollection("sessions");
const sessions = (result.entries ?? []).map((entry) => ({
	id: entry.id,
	...entry.data,
}));
const editing = editId ? sessions.find((session) => session.id === editId) : undefined;
if (editId && !editing && !submitted) formError = formError ?? "Session not found.";
const formInitial = submitted ?? (editing ? sessionToFormValues(editing) : undefined);
const loadError = result.error?.message;
const savedId = Astro.url.searchParams.get("saved") ?? undefined;
---

<BaseLayout title="Exercise Log · Bar Calculator" active="log">
	<ExerciseLog
		client:load
		sessions={sessions}
		error={loadError}
		formError={formError}
		formInitial={formInitial}
		savedId={savedId}
	/>
</BaseLayout>
