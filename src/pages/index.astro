---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import ExerciseLog from "../components/ExerciseLog";
import { activeWorkouts } from "../lib/workout";
import { env } from "cloudflare:workers";
import {
	deleteSession,
	formValuesFromFormData,
	insertSession,
	listSessions,
	sessionFromFormValues,
	sessionToFormValues,
	updateSession,
	type SessionFormValues,
} from "../lib/session";

Astro.response.headers.set("Cache-Control", "no-store");
const userId = Astro.locals.user!.id;
let formError: string | undefined;
let editId = Astro.url.searchParams.get("edit") ?? undefined;
let submitted: SessionFormValues | undefined;

if (Astro.request.method === "POST") {
	try {
		const form = await Astro.request.formData();
		const intent = String(form.get("intent") ?? "create");
		if (intent === "delete") {
			const id = String(form.get("id") ?? "");
			if (!id) throw new Error("Missing session.");
			if (!(await deleteSession(env.DB, userId, id))) throw new Error("Session not found.");
			return Astro.redirect("/");
		}
		if (intent !== "create" && intent !== "update") throw new Error("Unknown action.");
		submitted = formValuesFromFormData(form);
		const session = sessionFromFormValues(submitted);
		let savedId: string;
		if (intent === "update") {
			savedId = String(form.get("id") ?? "");
			editId = savedId || editId;
			if (!savedId) throw new Error("Missing session.");
			if (!(await updateSession(env.DB, userId, savedId, session))) throw new Error("Session not found.");
		} else {
			savedId = await insertSession(env.DB, userId, session);
		}
		return Astro.redirect(`/?saved=${savedId}`);
	} catch (err) {
		formError = err instanceof Error ? err.message : "Could not save session.";
	}
}

let sessions: Awaited<ReturnType<typeof listSessions>> = [];
let loadError: string | undefined;
try { sessions = await listSessions(env.DB, userId); }
catch { loadError = "Could not load sessions. Please try again."; }
const editing = editId ? sessions.find((session) => session.id === editId) : undefined;
if (editId && !editing && !submitted) formError = formError ?? "Session not found.";
const formInitial = submitted ?? (editing ? sessionToFormValues(editing) : undefined);
const savedId = Astro.url.searchParams.get("saved") ?? undefined;
let active: Awaited<ReturnType<typeof activeWorkouts>> = [];
let activeError: string | undefined;
try { active = await activeWorkouts(env.DB, userId); }
catch { activeError = "Could not load in-progress workouts. Please try again."; }
---

<BaseLayout title="Exercise Log · Bar Calculator" active="log">
	<ExerciseLog
		client:load
		sessions={sessions}
		error={loadError ?? activeError}
		active={active}
		formError={formError}
		formInitial={formInitial}
		savedId={savedId}
	/>
</BaseLayout>
