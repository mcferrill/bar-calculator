{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "barcalc",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-07-25",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "barcalc-db",
			"database_id": "15c9fd98-629d-4112-897b-92fe0813ec3b",
			"migrations_dir": "migrations"
		}
	]
}
