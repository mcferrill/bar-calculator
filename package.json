{
	"name": "barcalc",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "wrangler types && astro build",
		"preview": "astro build && astro preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply barcalc-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply barcalc-db --remote"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^14.1.4",
		"@astrojs/react": "^6.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"wrangler": "^4.114.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.22.0",
		"prettier": "^3.8.3"
	},
	"allowScripts": {}
}
